# ─────────────────────────────────────────────────────────────────
# Optional. Skills draft without any keys (copy-paste into LinkedIn).
# Set ZERNIO_API_KEY to publish, comment, and read connected-account
# data through Zernio REST + the hosted MCP server.
# ─────────────────────────────────────────────────────────────────

# Create at https://zernio.com/dashboard/api-keys  (format: sk_...)
ZERNIO_API_KEY=sk_your_key_here

# Optional if you have exactly one LinkedIn account connected in Zernio.
# Otherwise the client lists GET /api/v1/accounts and uses the only LinkedIn id.
# ZERNIO_LINKEDIN_ACCOUNT_ID=24_char_account_id
# LINKEDIN_ACCOUNT_ID=24_char_account_id

# Cursor MCP (hosted): https://mcp.zernio.com/mcp
# Send the same key as Authorization: Bearer $ZERNIO_API_KEY

# Optional illustrations (unchanged from the original bundle)
# PIXFARO_TOKEN=pf_live_your_token_here

# LINKEDIN_SKILLS_CUSTOM_POSTER=python /path/to/my-poster.py
